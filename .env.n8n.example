# Copy to .env.n8n (git-ignored) and fill in. Generate secrets with: openssl rand -hex 32

# Encrypts the credentials n8n stores (the SMTP credential). Keep it stable once set.
N8N_ENCRYPTION_KEY=

# HMAC secret for Convex -> n8n (event webhooks). Same value as LENDLOOP_TO_N8N_SECRET on Convex.
LENDLOOP_TO_N8N_SECRET=
# HMAC secret for n8n -> Convex (overdue list, write-backs). Same value as N8N_TO_LENDLOOP_SECRET on Convex.
N8N_TO_LENDLOOP_SECRET=

# Convex HTTP actions base URL (".convex.site", not ".convex.cloud").
#   Local backend (npx convex dev, run locally): http://host.docker.internal:3211
#   Cloud deployment:                        https://<your-deployment>.convex.site
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211

LENDLOOP_MAIL_FROM=LendLoop <no-reply@lendloop.local>
# Where workflow failure alerts go.
LENDLOOP_OPS_EMAIL=ops@lendloop.local
