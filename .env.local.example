# Copy to .env.local (git-ignored). `npx convex dev` also writes CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL here.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# These are set on the Convex deployment, not here (npx convex env set NAME value):
#   CLERK_JWT_ISSUER_DOMAIN      e.g. https://your-app.clerk.accounts.dev
#   N8N_LOAN_EVENTS_WEBHOOK_URL  e.g. http://localhost:5678/webhook/lendloop/loan-events
#   LENDLOOP_TO_N8N_SECRET       same value as in .env.n8n
#   N8N_TO_LENDLOOP_SECRET       same value as in .env.n8n
