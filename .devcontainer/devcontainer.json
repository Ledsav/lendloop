{
  // GitHub Codespaces / Dev Containers: Node 22 plus Docker (for n8n and Mailpit), nothing to
  // install locally. See "Run it in GitHub Codespaces" in the README.
  "name": "LendLoop",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Lets `gh codespace ssh` run commands in the codespace from a terminal.
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "npm ci && bash scripts/codespaces-env.sh",
  "forwardPorts": [3000, 3210, 5678, 8025],
  "portsAttributes": {
    "3000": { "label": "LendLoop", "onAutoForward": "notify" },
    "3210": { "label": "Convex (the browser talks to it)", "onAutoForward": "silent" },
    "3211": { "label": "Convex HTTP actions (n8n calls them)", "onAutoForward": "silent" },
    "5678": { "label": "n8n", "onAutoForward": "silent" },
    "8025": { "label": "Mailpit inbox", "onAutoForward": "silent" },
    "6790": { "label": "Convex dashboard", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": { "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"] }
  }
}
